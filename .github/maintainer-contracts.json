{
  "$schema": "../schemas/config.schema.json",
  "version": 1,
  "failLevel": "error",
  "skipDrafts": false,
  "title": {
    "pattern": "^(?:feat|fix|docs|test|refactor|perf|build|ci|chore)(?:\\([^)]+\\))?!?: .+",
    "maxLength": 100,
    "severity": "error"
  },
  "requiredSections": [
    { "heading": "Summary", "minChars": 40, "severity": "error" },
    { "heading": "Compatibility", "minChars": 4, "severity": "error" },
    { "heading": "Validation", "minChars": 10, "severity": "error" },
    { "heading": "Security impact", "minChars": 4, "severity": "error" },
    { "heading": "Public boundary", "minChars": 10, "severity": "error" },
    { "heading": "AI assistance", "minChars": 10, "severity": "error" }
  ],
  "checkboxes": [
    {
      "section": "Validation",
      "minChecked": 4,
      "requiredTexts": [
        "npm run verify",
        "npm pack --dry-run",
        "No credentials"
      ],
      "severity": "error"
    }
  ],
  "forbiddenPlaceholders": [
    {
      "name": "summary instruction",
      "pattern": "Describe the maintainer problem",
      "flags": "i",
      "severity": "error",
      "message": "Replace the summary instruction with reviewable evidence."
    },
    {
      "name": "security instruction",
      "pattern": "Explain possible bypasses",
      "flags": "i",
      "severity": "error",
      "message": "Replace the security instruction with an explicit impact statement."
    },
    {
      "name": "compatibility instruction",
      "pattern": "Describe policy-schema",
      "flags": "i",
      "severity": "error",
      "message": "Replace the compatibility instruction with an explicit statement."
    },
    {
      "name": "testing instruction",
      "pattern": "State the tools used",
      "flags": "i",
      "severity": "error",
      "message": "Replace the testing instruction with actual verification evidence."
    }
  ],
  "pathRules": [
    {
      "name": "runtime-or-public-api",
      "paths": ["src/**", "bin/**", "action.yml", "schemas/**"],
      "requireSections": [
        { "heading": "Compatibility", "minChars": 20, "severity": "error" }
      ],
      "requireCheckedTexts": ["parser/policy tests added or updated"],
      "severity": "error"
    },
    {
      "name": "workflow-or-token-boundary",
      "paths": ["src/github.mjs", "action.yml", ".github/workflows/**"],
      "requireSections": [
        { "heading": "Security impact", "minChars": 20, "severity": "error" },
        { "heading": "Validation", "minChars": 20, "severity": "error" }
      ],
      "requireCheckedTexts": ["No credentials"],
      "severity": "error"
    }
  ],
  "commitRules": {
    "enabled": true,
    "pattern": "^(?:feat|fix|docs|test|refactor|perf|build|ci|chore)(?:\\([^)]+\\))?!?: .+",
    "maxSubjectLength": 100,
    "ignoreMerges": true,
    "severity": "error"
  },
  "sizeRules": {
    "maxFiles": { "limit": 80, "severity": "warning" },
    "maxAdditions": { "limit": 2500, "severity": "warning" },
    "maxDeletions": { "limit": 2500, "severity": "warning" }
  },
  "aiDisclosure": {
    "section": "AI assistance",
    "required": true,
    "minChars": 10,
    "severity": "error"
  }
}
